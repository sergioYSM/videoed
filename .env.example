# Ownframe has no server-side data: these are the only settings.
NEXT_PUBLIC_SITE_URL=https://your-domain.example   # absolute URLs for link previews
NEXT_PUBLIC_ALLOW_INDEXING=false                   # set to true at public launch
# Local development behind an HTTP proxy only: Node's fetch ignores HTTPS_PROXY unless
# NODE_USE_ENV_PROXY=1 is set when starting the server (not needed on Vercel).
